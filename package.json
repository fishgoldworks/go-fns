{
  "name": "go-fns",
  "version": "2.0.0",
  "private": true,
  "description": "Utility functions for functions.",
  "license": "MIT",
  "author": {
    "name": "fishgoldworks",
    "url": "https://github.com/fishgoldworks"
  },
  "keywords": [
    "function",
    "utilities",
    "utils",
    "and",
    "or",
    "xor",
    "nor",
    "not",
    "logical",
    "connectives",
    "async",
    "pipeline",
    "typescript",
    "once",
    "sleep"
  ],
  "homepage": "https://github.com/fishgoldworks/go-fns",
  "repository": {
    "type": "git",
    "url": "https://github.com/fishgoldworks/go-fns.git"
  },
  "bugs": {
    "url": "https://github.com/fishgoldworks/go-fns/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "node scripts/build.js",
    "docs": "node scripts/docs.js",
    "docs:html": "npm run docs && node scripts/docs-html.js",
    "pack:package": "node scripts/pack-package.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "node scripts/format.mjs",
    "format:check": "prettier . --check",
    "test": "node scripts/test.js",
    "test:docs": "node scripts/docs.js --check && node --test test/docs/*.test.js && node scripts/run-tests.js test/documentation.test.js",
    "test:types": "node scripts/test-types.js",
    "test:build": "node --test test/build/*.test.js",
    "test:tooling": "node --test test/tooling/*.test.{js,mjs}",
    "test:artifacts": "node scripts/test-artifacts.js",
    "test:package": "node scripts/test-package.js",
    "test:release": "node --test test/package/*.test.js",
    "test:browser": "python scripts/test-browser-driver.py && python scripts/test-browser.py",
    "test:browser-driver": "python scripts/test-browser-driver.py",
    "coverage": "c8 --clean npm test",
    "coverage:native": "npm test -- --experimental-test-coverage --test-coverage-include=\"index.js\" --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"src/**/temp/**\" --test-coverage-exclude=\"src/**/.tmp/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "verify": "node scripts/check-dev-node.js && node scripts/verify.js",
    "verify:all": "node scripts/verify.js --browser",
    "verify:native": "node scripts/verify.js --native",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:adapters": "node scripts/benchmark-adapters.js",
    "benchmark:adapters:browser": "python scripts/benchmark-adapters-browser.py",
    "benchmark:browser": "python scripts/benchmark-browser.py",
    "prepack": "node scripts/root-package-guard.js",
    "prepublishOnly": "node scripts/root-package-guard.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "c8": "12.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "globals": "16.5.0",
    "markdown-it": "15.0.3",
    "prettier": "3.9.6",
    "terser": "5.51.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.1",
    "webpack": "5.111.1"
  },
  "overrides": {
    "minimatch@<11.0.1": "11.0.4",
    "test-exclude": {
      "glob": "14.0.3"
    }
  }
}
